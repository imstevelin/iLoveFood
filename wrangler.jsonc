{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ilovefood",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-08",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "ilovefood.imstevelin.com/*",
      "zone_name": "imstevelin.com"
    },
    {
      "pattern": "ilovefood-api.imstevelin.com/*",
      "zone_name": "imstevelin.com"
    }
  ],
  "assets": {
    "directory": "./dist/ilovefood",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "none",
    "run_worker_first": ["/api/*", "/health"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://ilovefood.imstevelin.com"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "ilovefood-auth",
      "database_id": "9e172bf8-43a5-424e-b6e7-1cd139e4360c",
      "migrations_dir": "migrations"
    }
  ],
  "secrets": {
    "required": [
      "OPENPOINT_GID",
      "OPENPOINT_MID",
      "OPENPOINT_VCODE",
      "OPENPOINT_IMAP_MASTER_KEY"
    ]
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
