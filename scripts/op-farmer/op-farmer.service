[Unit]
Description=7-ELEVEN mid_v token farmer
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=imstevelin
Group=imstevelin
SupplementaryGroups=kvm
WorkingDirectory=/home/imstevelin/op-farmer
ExecStart=/home/imstevelin/op-farmer/start_farmer.sh
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
OOMPolicy=kill
LimitNOFILE=8192
UMask=0077
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/imstevelin
Environment=XDG_RUNTIME_DIR=/run/user/1000
EnvironmentFile=-/etc/ilovefood/op-farmer.env
StandardOutput=append:/home/imstevelin/op-farmer/farmer_live.log
StandardError=append:/home/imstevelin/op-farmer/farmer_live.log

[Install]
WantedBy=multi-user.target
