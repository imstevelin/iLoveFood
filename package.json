{
  "name": "ilovefood",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/prepare-environments.mjs",
    "build": "ng build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --noUnusedLocals --noUnusedParameters",
    "check": "npm run typecheck && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy:status": "wrangler deployments list --name ilovefood",
    "deploy:logs": "wrangler tail ilovefood",
    "migrate:favorites": "node scripts/migrate-favorites-to-uid.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "engines": {
    "node": ">=22.22.3",
    "npm": ">=10"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/material": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@use-gesture/vanilla": "^10.3.1",
    "firebase": "^12.18.0",
    "fuse.js": "^7.5.0",
    "geolib": "^3.3.14",
    "marked": "^18.0.11",
    "motion": "^13.2.0",
    "pinyin-pro": "^3.29.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "overrides": {
    "qs": "6.16.0",
    "vitest": "4.1.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "~22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^22.20.1",
    "autoprefixer": "^10.5.5",
    "firebase-admin": "^14.3.0",
    "jasmine-core": "~6.0.1",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "postcss": "^8.5.28",
    "sass": "^1.104.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "wrangler": "^4.129.0"
  }
}
